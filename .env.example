# --- Database (bron van waarheid) ---
DATABASE_URL="postgresql://websup:websup@localhost:5432/websup_growth?schema=public"

# --- Auth (single user, self-hosted) ---
# Het wachtwoord waarmee jij inlogt
APP_PASSWORD="verander-dit-wachtwoord"
# Lange willekeurige string voor het sessiecookie. Genereer met: openssl rand -hex 32
AUTH_SECRET="verander-dit-naar-een-lange-random-string"

# --- AI provider ---
# Standaard provider: openai of claude
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-..."
# Model voor goedkope extractie / scoring
AI_MODEL_FAST="gpt-4o-mini"
# Model voor zwaardere taken (cases, content)
AI_MODEL_SMART="gpt-4o"

# Optioneel, voor later wisselen naar Claude
ANTHROPIC_API_KEY=""

# --- Filesystem (ondersteunend, niet de waarheid) ---
# Map op de VPS voor ruwe dumps, screenshots, exports, backups
DATA_DIR="./data"
